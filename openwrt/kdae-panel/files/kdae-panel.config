config kdae-panel 'main'
	option enabled '1'
	option listen_addr '0.0.0.0'
	# 上游默认 2023，这里改成 2026：OpenWrt 上 daed（luci-app-daed）默认也占 2023，
	# 两者同装时后启动的那个会直接绑不上端口。改默认值比让用户自己撞一次便宜。
	option listen_port '2026'
	# /var 在 OpenWrt 上是 /tmp 的软链，重启即空。数据库、备份、状态文件、
	# dae 本地版本库、GitHub Token 与自定义 geo 来源都必须落在 overlay 上，
	# 因此 init 脚本固定放在专用目录 /etc/kdae-panel；这里不再暴露可改路径。
	option dae_binary '/usr/bin/dae'
	option dae_config '/etc/dae/config.dae'
	option service_name 'dae'
	option enable_dae_install '1'
	# 上游默认关闭它，理由是"给部署新增一条常态化的联网取字节 → 以 root 写系统目录
	# 的路径"。这里默认打开：dae 的 geo 也归面板管，而上面的 enable_dae_install=1
	# 已经引入同一条路径且权限更大，再关掉 geo 只是逼用户手工放文件。
	# 反过来，若把 enable_dae_install 改成 0，应当一并把这一项也改成 0。
	option enable_geo_update '1'
	# 没有 enable_self_update：procd 后端下面板压根不注册自升级能力。上游
	# tuoro/kdae-panel 发布的二进制不含 procd 后端，升级一次就把面板换成不可用
	# 的程序。升级请安装新的 ipk。
	# 新版本检查仍然做，只是问的是本软件包自己的发布仓库
	# （senshinya/luci-app-kdae-panel）——那才是 opkg 装得上的那条版本线。
	option trusted_proxies '127.0.0.0/8,::1/128'
	option session_ttl '12h'
	option secure_cookie '0'
