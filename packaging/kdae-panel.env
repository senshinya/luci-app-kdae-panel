# 默认接受本机与局域网连接；暴露到公网前请通过反向代理提供 HTTPS。
KDAE_PANEL_LISTEN=0.0.0.0:2023

# 一次性初始化链接的根凭证，留空时会随机生成；也可在启动前显式设置。
KDAE_PANEL_BOOTSTRAP_TOKEN=

# 仅信任这些地址转发的 X-Forwarded-For / X-Forwarded-Proto。
KDAE_PANEL_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# dae 与 systemd 集成。
KDAE_PANEL_DAE_BINARY=/usr/bin/dae
KDAE_PANEL_DAE_CONFIG=/etc/dae/config.dae
KDAE_PANEL_SERVICE_NAME=dae
KDAE_PANEL_SYSTEMCTL=/usr/bin/systemctl
KDAE_PANEL_JOURNALCTL=/usr/bin/journalctl

# 本地状态和配置备份。
KDAE_PANEL_DATABASE=/var/lib/kdae-panel/panel.db
KDAE_PANEL_BACKUP_DIR=/var/lib/kdae-panel/backups
KDAE_PANEL_SCHEDULE_FILE=/var/lib/kdae-panel/schedule.json
KDAE_PANEL_INSTALL_STATE_FILE=/var/lib/kdae-panel/dae-install.json
KDAE_PANEL_GITHUB_TOKEN_FILE=/var/lib/kdae-panel/github-token
KDAE_PANEL_GEO_STATE_FILE=/var/lib/kdae-panel/geo-update.json
KDAE_PANEL_GEO_SCHEDULE_FILE=/var/lib/kdae-panel/geo-schedule.json
KDAE_PANEL_GEO_SOURCES_FILE=/var/lib/kdae-panel/geo-sources.json
KDAE_PANEL_BACKUP_FILE=/var/lib/kdae-panel/kdae-panel.previous
KDAE_PANEL_SESSION_TTL=12h

# 可选的 GitHub API Token。留空时可在面板设置页填写；环境变量一旦非空，
# 设置页只显示状态且不能覆盖。只需读取公开仓库，不要授予写权限。
KDAE_PANEL_GITHUB_TOKEN=

# 默认允许通过面板首次安装、升级与切换 dae。发行单元已开放默认路径
# /usr/bin 与 /etc/systemd/system；若 dae 位于其他目录，仍需把实际目录加入
# ReadWritePaths。不需要版本管理时可改为 false，并按需收紧服务单元。
KDAE_PANEL_ENABLE_DAE_INSTALL=true

# 兼容旧版本的环境变量；Geo 数据管理现在始终在登录后可用。所有下载都要求
# 公网 HTTPS 与 SHA-256 校验，更新只触发 dae reload，不重启。
KDAE_PANEL_ENABLE_GEO_UPDATE=true

# 关闭面板自身的新版本检查。检查只读取本仓库 releases/latest 的 tag 并缓存 6 小时，
# 但"不开安装与 geo 的部署从不外联"是一条有人在意的性质，因此留出这个开关。
KDAE_PANEL_DISABLE_UPDATE_CHECK=false

# 面板一键升级的初始值。安装后可直接在设置页开关，界面选择持久化在
# /var/lib/kdae-panel/self-update.json，并优先于这里的初始值。
# 没有自动回滚：替换前会让新二进制自证可运行，上一版复制到 KDAE_PANEL_BACKUP_FILE。
KDAE_PANEL_ENABLE_SELF_UPDATE=true

# 通过 HTTPS 反向代理访问时改为 true。
KDAE_PANEL_SECURE_COOKIE=false
